# Copy to .env.local for local development; set the same keys in your host (e.g. Vercel) for production.

# Public URL of the site, used for SEO metadata, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Public contact email shown on the site (leave empty to hide it)
NEXT_PUBLIC_CONTACT_EMAIL=

# Early-access form delivery via https://resend.com
# Without these, production returns 503 so leads are never silently lost.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=you@your-domain.com
# Must be on a domain verified in Resend; the default sandbox sender only delivers to your own Resend account email.
RESEND_FROM=ClaraFord <hello@your-domain.com>
